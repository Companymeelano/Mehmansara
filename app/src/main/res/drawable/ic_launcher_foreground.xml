    <path
        android:fillColor="#2EC8A96A"
        android:pathData="M54,52 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0" />
    <!-- crescent moon -->
    <path
        android:fillColor="#E8D6AE"
        android:pathData="M74,18 a11,11 0 1,0 8,18.5 a8.6,8.6 0 1,1 -8,-18.5 Z" />
    <!-- star -->
    <path
        android:fillColor="#E8D6AE"
        android:pathData="M58,20 l1.8,4.2 4.2,1.8 -4.2,1.8 -1.8,4.2 -1.8,-4.2 -4.2,-1.8 4.2,-1.8 Z" />
