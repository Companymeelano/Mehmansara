<?xml version="1.0" encoding="utf-8"?>
<!-- MEHRA mark — "rest house of the teachers" (خوابگاه/استراحتگاه معلمان آموزش و پرورش):
     a gold crescent moon and star over a made bed with a pillow, and a graduation-cap
     (کلاه danesh‌آموزی) resting on the pillow — education + rest in one emblem.
     Layered champagne golds over a soft halo read as a 3D relief on every launcher. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
