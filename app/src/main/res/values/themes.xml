<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Persian-only, RTL, Material 3 driven by Compose. The XML theme only provides
         the window background + splash so there is no flash of an unstyled window. -->
    <style name="Theme.Mehra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mehra_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Mehra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mehra_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Mehra</item>
    </style>
</resources>
