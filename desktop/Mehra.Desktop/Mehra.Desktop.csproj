<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Mehra</AssemblyName>
    <RootNamespace>Mehra.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.1.6</Version>
    <AssemblyVersion>1.1.6.0</AssemblyVersion>
    <FileVersion>1.1.6.0</FileVersion>
    <AssemblyTitle>MEHRA — Hospitality Management (Windows)</AssemblyTitle>
    <Description>سامانهٔ مدیریت مهمان‌پذیر فرهنگیان اهواز — نسخهٔ ویندوز 1.1.5 (کارکنان — اتصال مستقیم به SQL Server) — www.meelano.ir — 09120219593</Description>
    <Product>MEHRA</Product>
    <Company>Culturalists of Ahvaz — فرهنگیان اهواز</Company>
    <Copyright>Copyright © 2026 — طراح و توسعه‌دهنده: میلاد یعقوبی</Copyright>
    <ApplicationIcon>Assets\mehra.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.5" />
    <!-- Windows-only, in-box SNI: keeps the exe small (no native payload like Microsoft.Data.SqlClient) -->
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- schema.sql is ALSO embedded in the exe, so «راه‌اندازی جداول» works even if the db\ folder is missing -->
    <EmbeddedResource Include="db\schema.sql" />
  </ItemGroup>

</Project>
