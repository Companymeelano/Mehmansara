<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Mehra</AssemblyName>
    <RootNamespace>Mehra.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyTitle>MEHRA — Hospitality Management (Windows)</AssemblyTitle>
    <Description>سامانهٔ مدیریت مهمان‌پذیر فرهنگیان اهواز — نسخهٔ ویندوز (کارکنان)</Description>
    <Product>MEHRA</Product>
    <Company>Culturalists of Ahvaz — فرهنگیان اهواز</Company>
    <Copyright>Copyright © 2026 — طراح و توسعه‌دهنده: میلاد یعقوبی</Copyright>
    <ApplicationIcon>Assets\mehra.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
