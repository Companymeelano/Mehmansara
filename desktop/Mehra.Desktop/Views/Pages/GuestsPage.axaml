<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mehra.Desktop.Views.Pages.GuestsPage">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <TextBlock Text="مهمانان" FontSize="22" Classes="bold" />
      <Button Grid.Column="1" Content="+ مهمان جدید" Classes="primary" Click="OnAdd" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="card" Margin="6,4">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="{Binding Name}" Classes="bold" FontSize="15" />
                <TextBlock Text="{Binding PhoneFa}" Foreground="#5A6474" FontSize="12" />
                <TextBlock Text="{Binding City}" Foreground="#8A93A3" FontSize="11" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel Spacing="3" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding BalanceFa}" FontSize="13" Classes="bold" Foreground="{Binding BalanceBrush}" />
                  <TextBlock Text="{Binding StaysFa}" FontSize="11" Foreground="#8A93A3" />
                  <TextBlock Text="{Binding LastFa}" FontSize="11" Foreground="#8A93A3" />
                </StackPanel>
                <Button Classes="icon" Content="✎" ToolTip.Tip="ویرایش مهمان" Tag="{Binding}" Click="OnEdit" />
                <Button Classes="iconDanger" Content="🗑" ToolTip.Tip="حذف مهمان" Tag="{Binding}" Click="OnDelete" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Status}" Foreground="#8A93A3" FontSize="11" />
  </StackPanel>
</UserControl>
