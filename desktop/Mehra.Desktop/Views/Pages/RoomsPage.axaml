<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mehra.Desktop.Views.Pages.RoomsPage">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <TextBlock Text="🛏  اتاق‌ها" FontSize="22" Classes="bold" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="+ افزودن اتاق" Classes="primary" Click="OnAddRoom" />
        <Button Content="🔄 تغییر وضعیت اتاق" Classes="ghost" Foreground="#16233D" BorderBrush="#D8CBA6" Click="OnStatus" />
      </StackPanel>
    </Grid>
    <ItemsControl ItemsSource="{Binding Rooms}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Width="210" Margin="5" Padding="12" CornerRadius="14"
                  Background="#FFFFFFFC" BorderBrush="#E4D9BE" BorderThickness="1"
                  BoxShadow="0 6 16 0 #1A16233D">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="17" Classes="bold" Foreground="#16233D" />
                <Border Grid.Column="1" Background="{Binding StatusBrush}" CornerRadius="999" Padding="8,3"
                        BoxShadow="0 2 6 0 #26000000">
                  <TextBlock Text="{Binding StatusFa}" FontSize="10" Classes="bold" Foreground="White" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding TypeName}" Foreground="#B08D3E" FontSize="11.5" Classes="bold" />
              <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#5A6474" />
              <TextBlock Text="{Binding Amenities}" FontSize="10" Foreground="#8A93A3" TextWrapping="Wrap" MaxLines="2" />
              <TextBlock Text="{Binding RateFa}" FontSize="11.5" Classes="bold" Foreground="#16233D" />
              <TextBlock Text="{Binding GuestName}" FontSize="11" Classes="bold" Foreground="#2E7D5B" />
              <Button Classes="icon" Content="✎ ویرایش" HorizontalAlignment="Left" FontSize="11" Padding="8,4" Tag="{Binding}" Click="OnEditRoom" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Status}" Foreground="#8A93A3" FontSize="11" />
  </StackPanel>
</UserControl>
