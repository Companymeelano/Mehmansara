<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mehra.Desktop.Views.Pages.SettingsPage">
  <StackPanel Spacing="12" MaxWidth="560">
    <TextBlock Text="تنظیمات" FontSize="22" Classes="bold" />
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="نشانی سرور" Classes="bold" />
        <TextBlock Text="{Binding ServerLabel}" Foreground="#5A6474" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Mode}" Foreground="#5A6474" TextWrapping="Wrap" />
        <Button Classes="ghost" Content="بررسی اتصال به سرور" Click="OnHealth" HorizontalAlignment="Right" Foreground="#8A6A2F" BorderBrush="#D8CBA6" />
        <TextBlock Text="{Binding Health}" Foreground="#2E7D5B" TextWrapping="Wrap" />
        <Button Classes="primary" Content="راه‌اندازی/به‌روزرسانی جداول پایگاه داده (SQL Server)" Click="OnEnsureSchema" HorizontalAlignment="Right" IsVisible="{Binding IsSql}" />
        <TextBlock Text="{Binding SchemaStatus}" Foreground="#5A6474" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLocal}">
          <Button Classes="primary" Content="💾 ذخیرهٔ پشتیبان" Click="OnBackup" />
          <Button Classes="ghost" Foreground="#16233D" BorderBrush="#D8CBA6" Content="♻ بازیابی آخرین پشتیبان" Click="OnRestore" />
          <Button Classes="danger" Content="پاک‌سازی کامل داده‌ها" Click="OnResetData" />
        </StackPanel>
        <TextBlock Text="{Binding ResetStatus}" Foreground="#2E7D5B" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="دربارهٔ برنامه" Classes="bold" />
        <TextBlock x:Name="VersionText" Text="فراسا — نسخهٔ ویندوز" />
        <TextBlock Text="سامانهٔ مدیریت مهمان‌پذیر فرهنگیان ناحیه ۳ اهواز — داده‌ها در فایل محلی ذخیره می‌شوند و با سرور شبکهٔ محلی (پورت ۵۰۵۰) به اندروید هم می‌رسند." TextWrapping="Wrap" Foreground="#5A6474" />
        <TextBlock Text="طراح و توسعه‌دهنده: میلاد یعقوبی" Classes="bold" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
