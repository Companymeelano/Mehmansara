<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mehra.Desktop.Views.Pages.ReservationsPage">
  <StackPanel Spacing="12">
    <TextBlock Text="رزروها" FontSize="22" Classes="bold" />
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="card" Margin="6,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                <TextBlock Text="{Binding Code}" FontSize="16" Classes="bold" />
                <Border Background="{Binding StatusBrush}" CornerRadius="999" Padding="8,3" HorizontalAlignment="Start">
                  <TextBlock Text="{Binding StatusFa}" FontSize="10" Foreground="White" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding GuestName}" Classes="bold" />
                <TextBlock Text="{Binding PhoneFa}" Foreground="#5A6474" FontSize="12" />
                <TextBlock Text="{Binding DatesFa}" Foreground="#5A6474" FontSize="12" />
                <TextBlock Text="{Binding RoomNumber}" Foreground="#5A6474" FontSize="12" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                <TextBlock Text="{Binding GuestsFa}" FontSize="12" Foreground="#5A6474" />
                <TextBlock Text="{Binding AmountFa}" FontSize="13" Classes="bold" />
                <TextBlock Text="{Binding PaidFa}" FontSize="11" Foreground="#8A93A3" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Status}" Foreground="#8A93A3" FontSize="11" />
  </StackPanel>
</UserControl>
