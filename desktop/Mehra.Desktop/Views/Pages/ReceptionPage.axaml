<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mehra.Desktop.Views.Pages.ReceptionPage">
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="پذیرش — ثبت اقامت مهمان" FontSize="22" Classes="bold" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="BackBtn" Content="↩ برگشت" Classes="ghost" Foreground="#16233D" BorderBrush="#D8CBA6" Click="OnBack" IsVisible="False" />
        <Button Content="+ افزودن مهمان جدید" Classes="primary" Click="OnAddNewGuest" />
      </StackPanel>
    </Grid>

    <!-- Step 1: Select or Search Existing Guest -->
    <Border x:Name="Step1Panel" Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="مرحلهٔ ۱ از ۳ — انتخاب مهمان (یا افزودن مهمان جدید)" FontSize="15" Classes="bold" />
        <TextBox x:Name="GuestSearchBox" Watermark="جست‌وجوی مهمان (نام، تلفن، کد ملی، شهر، خودرو، پلاک…)" TextChanged="OnGuestSearch" />
        <ItemsControl x:Name="GuestList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,4">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}" Classes="bold" FontSize="14" />
                    <TextBlock Text="{Binding PhoneFa}" Foreground="#5A6474" FontSize="12" />
                    <TextBlock Text="{Binding City}" Foreground="#8A93A3" FontSize="11" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="انتخاب مهمان ←" Classes="primary" Tag="{Binding}" Click="OnSelectGuest" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Step 2: Select Room -->
    <Border x:Name="Step2Panel" Classes="card" IsVisible="False">
      <StackPanel Spacing="10">
        <TextBlock x:Name="SelectedGuestBanner" FontSize="15" Classes="bold" Foreground="#B08D3E" />
        <TextBlock Text="مرحلهٔ ۲ از ۳ — انتخاب اتاق از اتاق‌های آزاد" FontSize="15" Classes="bold" />
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="تعداد شب اقامت" FontSize="12" Classes="bold" />
            <TextBox x:Name="NightsBox" Text="1" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="تعداد نفرات" FontSize="12" Classes="bold" />
            <TextBox x:Name="GuestsCountBox" Text="1" />
          </StackPanel>
        </Grid>
        <ItemsControl x:Name="FreeRoomList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,4">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Number}" Classes="bold" FontSize="15" />
                    <TextBlock Text="{Binding TypeName}" Foreground="#5A6474" FontSize="12" />
                    <TextBlock Text="{Binding Details}" Foreground="#8A93A3" FontSize="11" />
                    <TextBlock Text="{Binding RateFa}" Classes="bold" FontSize="12" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="انتخاب اتاق و پرداخت ←" Classes="primary" Tag="{Binding}" Click="OnSelectRoom" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Step 3: Payment & Print Invoice -->
    <Border x:Name="Step3Panel" Classes="card" IsVisible="False">
      <StackPanel Spacing="10">
        <TextBlock x:Name="SummaryBanner" FontSize="15" Classes="bold" Foreground="#B08D3E" TextWrapping="Wrap" />
        <TextBlock Text="مرحلهٔ ۳ از ۳ — دریافت هزینه و صدور رسید" FontSize="15" Classes="bold" />
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="مبلغ دریافتی (ریال)" FontSize="12" Classes="bold" />
            <TextBox x:Name="PayAmountBox" Text="0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="روش پرداخت" FontSize="12" Classes="bold" />
            <ComboBox x:Name="PayMethodCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
              <ComboBoxItem Content="نقدی" />
              <ComboBoxItem Content="دستگاه پوز" />
              <ComboBoxItem Content="کارت به کارت / انتقال" />
            </ComboBox>
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="حساب مدیر" FontSize="12" Classes="bold" />
            <TextBox x:Name="ManagerAcctBox" Text="صندوق نقدی مدیر" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="شماره پیگیری / توضیحات" FontSize="12" Classes="bold" />
            <TextBox x:Name="PayNoteBox" Watermark="اختیاری" />
          </StackPanel>
        </Grid>
        <Button Content="✓ ثبت نهایی اقامت، دریافت وجه و چاپ فاکتور" Classes="primary" HorizontalAlignment="Left" Click="OnCompleteStay" />
      </StackPanel>
    </Border>

    <TextBlock x:Name="WizardStatus" Foreground="#5A6474" FontSize="12" />
  </StackPanel>
</UserControl>
