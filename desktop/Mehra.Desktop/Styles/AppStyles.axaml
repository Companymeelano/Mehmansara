<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window, UserControl">
    <Setter Property="FontFamily" Value="avares://Mehra/Assets/Fonts/vazirmatn_regular.ttf#Vazirmatn" />
    <Setter Property="FlowDirection" Value="RightToLeft" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="avares://Mehra/Assets/Fonts/vazirmatn_regular.ttf#Vazirmatn" />
  </Style>

  <Style Selector="TextBlock.bold">
    <Setter Property="FontFamily" Value="avares://Mehra/Assets/Fonts/vazirmatn_bold.ttf#Vazirmatn" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#B08D3E" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C9A24B" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#8F7030" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#B3261E" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#CC362E" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="#F3EDE0" />
    <Setter Property="Foreground" Value="#16233D" />
    <Setter Property="BorderBrush" Value="#DFD3B6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E8D6AE" />
  </Style>

  <Style Selector="Button.iconDanger">
    <Setter Property="Background" Value="#FDF1F0" />
    <Setter Property="Foreground" Value="#B3261E" />
    <Setter Property="BorderBrush" Value="#EFCAC7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.iconDanger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F9DEDC" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#E8D6AE" />
    <Setter Property="BorderBrush" Value="#3A4A66" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22304C" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="#FFFFFFFC" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BorderBrush" Value="#E4D9BE" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #1216233D" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderBrush" Value="#D8CBA6" />
    <Setter Property="Background" Value="#FFFDF8" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#B08D3E" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="10,6" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Foreground" Value="#D2D8E2" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#24365C" />
    <Setter Property="Foreground" Value="#F7F4EC" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#C9A24B" />
    <Setter Property="Foreground" Value="#101A2E" />
  </Style>

</Styles>
